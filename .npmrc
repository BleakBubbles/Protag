# expo-router pulls web-only deps (vaul -> @radix-ui/*) whose react-dom peer wants
# react ^19.2.8, while Expo SDK 57 pins react 19.2.3. Nothing in an Android build
# uses them, but npm still refuses to resolve the tree.
#
# `npx expo install` already applies this internally; without it here, EAS Build's
# `npm ci` fails during "Install dependencies". The lockfile was resolved under this
# setting, so it must stay on for installs to be reproducible.
legacy-peer-deps=true
