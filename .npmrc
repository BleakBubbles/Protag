# Two peer ranges npm would otherwise refuse to resolve:
# - expo-router pulls web-only deps (vaul -> @radix-ui/*) whose react-dom peer can
#   disagree with the react version the Expo SDK pins. Nothing in an Android build
#   uses them.
# - expo-music-library 1.3.2 declares expo <58 and react-native <0.87; it's used on
#   SDK 58 / React Native 0.88 ahead of a release that says so.
#
# `npx expo install` already applies this internally; without it here, EAS Build's
# `npm ci` fails during "Install dependencies". The lockfile was resolved under this
# setting, so it must stay on for installs to be reproducible.
legacy-peer-deps=true
